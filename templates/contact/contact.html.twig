{% extends 'base.html.twig' %}

{% block title %}Hello ContactController!{% endblock %}

{% block body %}
<div class="container my-5">
{# Affichage du message de succès #}
{% for message in app.flashes('success') %}
    <div class="alert alert-success mt-3 rounded-pill text-center shadow-sm">
        {{ message }}
    </div>
{% endfor %}
    {{ form_start(contactForm) }}
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(contactForm.prenom) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_row(contactForm.nom) }}
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(contactForm.email) }}
            </div>
            <div class="col-md-6 mb-3">
                {# Tu peux ajouter le champ téléphone ici #}
            </div>
        </div>

        <div class="mb-3">
            {{ form_row(contactForm.vous_etes) }}
        </div>

        <div class="mb-3">
            {{ form_row(contactForm.message) }}
        </div>

        <button type="submit" class="btn btn-primary rounded-pill px-4">Envoyer</button>
    {{ form_end(contactForm) }}
</div>
{% endblock %}
