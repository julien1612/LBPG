{% extends 'base.html.twig' %}

{% block title %}Actualités - Le Bonheur des Petits Guerriers{% endblock %}

{% block body %}
	<div class="container">
		{% for article in articles %}
			<div class="row justify-content-center mb-5">
	<div class="container col-11 col-md-10 col-lg-8 mx-auto custom-card">

					<h2 class="text-center text-md-start border-bottom border-secondary pb-2 mb-4">
						{{ article.titre }}
					</h2>

					<div class="contenu_article mb-4">
						{{ article.contenu|raw }}
					</div>

					<div class="date_article mb-4">
						<small class="text-muted">
							<em>Publié le
								{{ article.createdAt|date('d/m/Y') }}</em>
						</small>
					</div>

					<div class="row g-3 justify-content-center">
						{% for photo in article.images %}
							<div class="col-12 col-sm-6">
								<img src="{{ asset('uploads/pictures/' ~ photo.nom) }}" class="img-fluid rounded shadow-sm" alt="{{ article.titre }}" style="width: 100%; height: 250px; object-fit: cover;">
							</div>
						{% else %}
							<div class="col-12 text-center">
								<p class="text-muted italic">Aucune photo disponible.</p>
							</div>
						{% endfor %}
					</div>
				</div>
			</div>
		{% endfor %}
		<div class="navigation d-flex justify-content-center mb-5">
			{{ knp_pagination_render(articles) }}
		</div>
	</div>
{% endblock %}
