<!DOCTYPE html>
<html lang="fr"> 
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="L'association Le Bonheur des Petits Guerriers apporte de la joie et du soutien aux enfants hospitalisés au CMI de Romagnat.">
        
        <meta property="og:title" content="Le Bonheur des Petits Guerriers">
        <meta property="og:type" content="website">
        <meta property="og:description" content="Soutien aux enfants hospitalisés en neurologie.">
        <meta property="og:image" content="{{ asset('pictures/logo.webp') }}">

        <title>{% block title %}Le Bonheur des Petits Guerriers{% endblock %}</title>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Delius&display=swap" rel="stylesheet">

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>

    <body>
        {% block header %}
            {% include 'partial/header.html.twig' %}
        {% endblock %}

        <section class="banner mb-5">
            <div class="banner-content">
                <h1 class="banner-text">
                    {% if flash is defined and flash is not null and flash.isActive %}
                        {{ flash.content|raw }}
                    {% else %}
                        <span class="visually-hidden">Association Le Bonheur des Petits Guerriers : </span>
                        Quand la force d'une asso
                        <br>
                        devient le sourire d'un enfant
                    {% endif %}
                </h1>

                {% if flash and flash.isActive and flash.image %}
                    <img src="{{ asset('pictures/' ~ flash.image) }}" class="banner-logo" alt="Actualité : {{ flash.content|striptags }}" loading="eager">
                {% else %}
                    <img src="{{ asset('pictures/logo.webp') }}" class="banner-logo" alt="Logo de l'association Le Bonheur des Petits Guerriers" loading="eager">
                {% endif %}
            </div>
        </section>

        <main class="container"> 
            {% block body %}{% endblock %}
        </main>

        {% block footer %}
            {% include 'partial/footer.html.twig' %}
        {% endblock %}
    </body>
</html>