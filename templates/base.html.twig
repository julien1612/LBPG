<!DOCTYPE html>
<html>
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="L'association Le Bonheur des Petits Guerriers apporte de la joie et du soutien aux enfants hospitalisés en service de neurologie. Découvrez notre histoire et nos actions.">
    <meta name="keywords" content="association, enfants malades, neurologie, petits guerriers, solidarité">
    <title>{% block title %}Le Bonheur des Petits Guerriers{% endblock %}</title>


        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Delius&display=swap" rel="stylesheet">

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>

    <body>
        {% block header %}
            {% include 'partial/header.html.twig' %}
        {% endblock %}

   <section class="banner mb-5">
    <div class="banner-content">
        <h1 class="banner-text">
            Quand la force d'une asso <br> 
            devient le sourire d'un enfant
        </h1>
        <img src="{{ asset('pictures/logo.png') }}" class="banner-logo" alt="Logo">
    </div>
</section>

        <div class="container"> 
            {% block body %}{% endblock %}
        </div>

        {% block footer %}
            {% include 'partial/footer.html.twig' %}
        {% endblock %}
    </body>
</html>